generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  wallets        Wallet[]
  createdLobbies Lobby[]       @relation("LobbyCreator")
  lobbySeats     LobbyPlayer[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Wallet {
  id         String    @id @default(cuid())
  userId     String
  address    String
  chain      String
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chain, address])
  @@index([userId])
}

model Lobby {
  id              String          @id @default(cuid())
  name            String
  visibility      LobbyVisibility @default(PUBLIC)
  status          LobbyStatus     @default(WAITING)
  smallBlind      Int
  bigBlind        Int
  minBuyIn        Int
  maxBuyIn        Int
  maxPlayers      Int             @default(9)
  passwordHash    String?
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdBy User          @relation("LobbyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  players   LobbyPlayer[]
  hands     HandHistory[]

  @@index([status, visibility])
  @@index([createdByUserId])
}

model LobbyPlayer {
  id         String            @id @default(cuid())
  lobbyId    String
  userId     String
  seatNumber Int?
  chipStack Int?
  status     LobbyPlayerStatus @default(JOINED)
  joinedAt   DateTime          @default(now())
  leftAt     DateTime?

  lobby Lobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lobbyId, userId])
  @@unique([lobbyId, seatNumber])
  @@index([userId])
}

model HandHistory {
  id                     String   @id @default(cuid())
  lobbyId                String
  handNumber             Int
  potSize                Int
  winnerUserIds          String[]
  winningHandName        String?
  winningHandDescription String?
  board                  Json
  awards                 Json
  showdownHands          Json
  completedAt            DateTime @default(now())

  lobby Lobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)

  @@unique([lobbyId, handNumber])
  @@index([lobbyId, completedAt])
}

enum LobbyVisibility {
  PUBLIC
  PRIVATE
}

enum LobbyStatus {
  WAITING
  ACTIVE
  CLOSED
}

enum LobbyPlayerStatus {
  JOINED
  SEATED
  LEFT
  KICKED
}
