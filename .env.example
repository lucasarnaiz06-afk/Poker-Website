DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poker_platform?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# 32-byte key (base64 or 64 hex chars) used to encrypt TOTP secrets (AES-256-GCM) and to HMAC IPs,
# rate-limit keys and recovery codes. Generate with: openssl rand -base64 32
# Changing it invalidates existing 2FA setups and recovery codes.
AUTH_ENCRYPTION_KEY=""

# Where middleware (edge) reaches this Next server to check sessions/onboarding. Defaults to NEXTAUTH_URL;
# set it when NEXTAUTH_URL is a public tunnel (ngrok) so checks stay local.
INTERNAL_APP_URL="http://localhost:3000"

# Number of reverse proxies in front of Next that append X-Forwarded-For (0 in local dev, 1 behind
# nginx/ngrok/a load balancer). Used for per-IP auth rate limits. With 0, forwarding headers (which clients
# can forge) are ignored and only per-account/per-email/site-wide limits apply.
TRUSTED_PROXY_COUNT="0"

# Site-wide ceiling on password sign-ups per minute (default 20).
REGISTRATION_RATE_LIMIT_PER_MINUTE="20"

# Optional sign-up allow-list (comma-separated domains or full addresses). Empty = anyone can sign up.
ALLOWED_EMAIL_DOMAINS=""
# Optional. If omitted, the client mirrors ALLOWED_EMAIL_DOMAINS.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=""

# Email delivery: "console" prints emails (magic links, verification, password reset) to the Next server
# log; "smtp" sends them. Defaults to console unless NODE_ENV=production.
EMAIL_TRANSPORT="console"
EMAIL_FROM="Poker Platform <noreply@university.edu>"

# Option A: SMTP URL. URL-encode email usernames and special password characters.
# Example user@university.edu -> user%40university.edu
EMAIL_SERVER="smtp://user%40university.edu:password@smtp.example.com:587"

# Option B: Structured SMTP config. Preferred when credentials contain special characters.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_SERVER_SECURE="false"

# Verify SMTP credentials with:
# npm run smtp:verify

# Optional OAuth provider (the Google button only shows when both are set).
# Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

CLIENT_ORIGIN="http://localhost:3000"
# Optional comma-separated list for LAN/dev devices, for example:
# CLIENT_ORIGINS="http://localhost:3000,http://192.168.1.25:3000"
CLIENT_ORIGINS=""
# Browsers open their socket.io connection here directly, so WebSockets work (the Next /socket.io rewrite only
# proxies HTTP, so through it clients fall back to long-polling). The game server must allow the page origin
# (CLIENT_ORIGIN/CLIENT_ORIGINS; any localhost:3000-3999 in development) and receive the session cookie, so
# use the same site as the app. Leave empty to go through the same-origin /socket.io path (production behind a
# reverse proxy that routes /socket.io to the game server; see README).
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# Optional: tests use DATABASE_URL with the database renamed to poker_platform_test unless this is set.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poker_platform_test?schema=public"
# Command center (/command). Also requires NEXTAUTH_SECRET (used to sign its 8-hour sessions).
COMMAND_CENTER_PASSWORD=""
PORT="4000"
# Interface the game server binds to. Loopback is enough when browsers go through the Next /socket.io
# rewrite; use 0.0.0.0 only if clients connect to it directly (NEXT_PUBLIC_SOCKET_URL) and firewall it.
HOST="127.0.0.1"
# Reverse-proxy hops the game server trusts for X-Forwarded-For (0 = ignore it; clients can forge it).
TRUST_PROXY_HOPS="0"
